# ==========================================
# CONFIGURACIÓN DEL SISTEMA DE AUDITORÍA OCR
# ==========================================

# Conexión a Base de Datos MySQL (Laragon predeterminado)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=auditoria_registros

# Ruta predeterminada de escaneo (puede ser ruta UNC de red o local)
DEFAULT_SCAN_PATH=\\172.40.5.84\ssdirec\COPIA_REGISTROS
SCAN_RECURSIVE=false

# Servidor Web Dashboard
WEB_HOST=127.0.0.1
WEB_PORT=8000

# Procesamiento OCR y Rendimiento
OCR_LANG=es
OCR_DPI=150
MAX_WORKERS=4

# Ruta de MySQL de Laragon (para autoarranque en 1-clic)
LARAGON_MYSQL_EXE=C:\laragon\bin\mysql\mysql-8.0.30-winx64\bin\mysqld.exe
LARAGON_MYSQL_INI=C:\laragon\bin\mysql\mysql-8.0.30-winx64\my.ini
